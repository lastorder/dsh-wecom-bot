{
  // Browser half: type-check only; scripts/build-client.mjs bundles with esbuild.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "types": []
  },
  "include": ["src/client/**/*", "src/shared/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
